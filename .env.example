# --- Telegram ---
# Bot token from @BotFather. Revoke and reissue if it was ever committed.
TELEGRAM_TOKEN=123456789:AAExampleTokenReplaceMe
# Your numeric Telegram user id (message @userinfobot to find it).
CHAT_ID=000000000

# --- Google Sheets ---
# The id between /d/ and /edit in the spreadsheet URL.
SPREADSHEET_ID=your_spreadsheet_id_here
# Full service-account JSON on one line. The service account email must be
# added as an Editor on the spreadsheet.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Receipt image hosting (optional) ---
# Free key from https://api.imgbb.com/. Without it, receipt links fall back to
# temporary Telegram file URLs that expire within hours.
IMGBB_API_KEY=

# --- Dashboard (optional) ---
# When set, GET / requires ?key=<value>. Leave empty to expose it publicly.
DASHBOARD_SECRET=

# --- Local development only ---
# Never enable this against a production bot token: polling deletes the webhook.
ENABLE_POLLING=false
PORT=3000
